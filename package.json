{
    "name": "api-mocker",
    "version": "1.0.0",
    "description": "",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./node": {
            "types": "./dist/node.d.ts",
            "import": "./dist/node.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "import": "./dist/vite.js"
        }
    },
    "type": "module",
    "scripts": {
        "build": "tsc && tsc-alias",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "demo": "npm run demo:core",
        "demo:core": "npm run build && node demo/core/index.ts",
        "demo:node": "npm run build && node demo/node/index.ts",
        "demo:http": "npm run demo:node",
        "demo:vite": "npm run build && vite demo/vite --config demo/vite/vite.config.ts --host 127.0.0.1",
        "docs": "typedoc",
        "docs:watch": "typedoc --watch"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.6.6",
        "eslint": "^10.14.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "tsc-alias": "^1.9.9",
        "typedoc": "^0.28.20",
        "typescript": "~6.0.0",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5"
    },
    "dependencies": {
        "@littlemissrobot/highfive": "^0.3.1"
    }
}
