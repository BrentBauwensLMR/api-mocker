{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src"
    ],
}
